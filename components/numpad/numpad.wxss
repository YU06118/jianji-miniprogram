.pad {
  display: flex;
  padding: 10rpx 12rpx;
  background: var(--bg-2);
  border-top: 2rpx solid var(--line);
}

.grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
}

.k {
  width: calc((100% - 24rpx) / 3);
  height: 98rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: var(--r-ctrl);
  font-size: 42rpx;
  font-weight: 600;
  color: var(--ink);
  box-shadow: var(--sh-card);
  font-variant-numeric: tabular-nums;
}
.k:nth-child(3n) {
  margin-right: 0;
}
.k:nth-child(n + 10) {
  margin-bottom: 0;
}
.k-fn {
  font-size: 38rpx;
  color: var(--ink-3);
  background: var(--bg-2);
  box-shadow: none;
}
.k-on {
  background: var(--pink-soft);
  transform: scale(0.96);
}

.side {
  width: 168rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.ok {
  height: 100%;
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-ctrl);
  background: var(--accent-solid);
  box-shadow: var(--sh-pop);
}
.ok-txt {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.ok-on {
  opacity: 0.82;
  transform: scale(0.98);
}
