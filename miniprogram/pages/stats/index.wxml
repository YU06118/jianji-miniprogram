<view class="theme-root {{compat && compat.rootClass ? compat.rootClass : ''}}" style="--nav-safe-top: {{navSafeTop}}px">
  <view class="bg-glow" />
  <view class="page-content {{enterSeq === 1 ? 'anim-tab-enter-a' : (enterSeq === 2 ? 'anim-tab-enter-b' : '')}}">
    <!-- 月份切换 -->
    <view class="stats-toolbar">
      <view class="stats-toolbar__arrow" bindtap="onPrevMonth">‹</view>
      <text class="stats-toolbar__label">{{currentMonth}}</text>
      <view class="stats-toolbar__arrow" bindtap="onNextMonth">›</view>
      <view class="stats-toolbar__budget" bindtap="goToBudget">预算设置</view>
    </view>

    <!-- 概览三列：数字滚动 -->
    <glass-card padded extClass="stats-overview">
      <view class="stats-overview__col">
        <text class="stats-overview__label">支出</text>
        <view class="stats-overview__value text-expense">
          <text>− ¥</text><number-roller value="{{expenseCents}}" />
        </view>
      </view>
      <view class="stats-overview__divider" />
      <view class="stats-overview__col">
        <text class="stats-overview__label">收入</text>
        <view class="stats-overview__value text-income">
          <text>+ ¥</text><number-roller value="{{incomeCents}}" />
        </view>
      </view>
      <view class="stats-overview__divider" />
      <view class="stats-overview__col">
        <text class="stats-overview__label">结余</text>
        <view class="stats-overview__value">
          <text>¥</text><number-roller value="{{balanceCents}}" />
        </view>
      </view>
    </glass-card>

    <view wx:if="{{empty}}" class="stats-empty">
      <view class="stats-empty__icon">◌</view>
      <view class="stats-empty__text">本月暂无数据</view>
      <view class="stats-empty__hint">记一笔后即可看到统计</view>
    </view>

    <block wx:else>
      <!-- 环形分类占比 -->
      <glass-card padded extClass="stats-card">
        <view class="stats-card__title">支出构成</view>
        <chart-donut
          segments="{{segments}}"
          centerLabel="{{centerLabel}}"
          centerValue="{{centerValue}}"
        />
        <view class="stats-ratios">
          <view wx:for="{{ratios}}" wx:key="name" class="stats-ratio">
            <view class="stats-ratio__dot" style="background: {{item.color}}" />
            <text class="stats-ratio__name">{{item.name}}</text>
            <view class="stats-ratio__bar">
              <view class="stats-ratio__fill" style="width: {{item.percent}}%; background: {{item.color}}" />
            </view>
            <text class="stats-ratio__value num">{{item.amountText}}</text>
            <text class="stats-ratio__percent num">{{item.percent}}%</text>
          </view>
        </view>
      </glass-card>

      <!-- 6 月趋势柱图 -->
      <glass-card padded extClass="stats-card">
        <view class="stats-card__title">近 6 月支出趋势</view>
        <chart-bar bars="{{barData}}" barColor="{{barColor}}" highlightColor="{{barHighlightColor}}" />
      </glass-card>

      <!-- 预算进度 -->
      <glass-card padded extClass="stats-card">
        <view class="stats-card__title">预算进度</view>
        <view wx:if="{{!hasBudget}}" class="stats-budget-empty">
          <view>尚未设置本月预算</view>
          <glass-button variant="secondary" bind:tapbutton="goToBudget">去设置</glass-button>
        </view>
        <view wx:else>
          <view wx:for="{{progresses}}" wx:key="name" class="stats-budget">
            <view class="stats-budget__head">
              <text class="stats-budget__name">{{item.name}}</text>
              <text class="stats-budget__num num">{{item.spentText}} / {{item.budgetText}}</text>
            </view>
            <view class="stats-budget__track">
              <view
                class="stats-budget__fill {{item.over ? 'stats-budget__fill--over' : (item.warning ? 'stats-budget__fill--warning' : '')}}"
                style="width: {{item.percent}}%"
              />
            </view>
            <view class="stats-budget__foot {{item.over ? 'text-expense' : ''}}">
              {{item.over ? '已超支 ¥' : '剩余 ¥'}}{{item.remainText}}
            </view>
          </view>
        </view>
      </glass-card>
    </block>
  </view>
</view>
