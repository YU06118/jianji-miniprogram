<view class="theme-root {{pageEnterSeq === 1 ? 'anim-page-enter-a' : (pageEnterSeq === 2 ? 'anim-page-enter-b' : 'anim-page-enter-idle')}} {{compat && compat.rootClass ? compat.rootClass : ''}}" style="--nav-safe-top: {{navSafeTop}}px">
  <view class="bg-glow" />
  <nav-bar title="搜索" />
  <view class="page-content page-content--under-nav">
    <glass-card padded>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索备注关键字"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view class="search-filter">
        <view class="search-chip {{type === 'expense' ? 'search-chip--active' : ''}}" data-type="expense" bindtap="onTypeChange">支出</view>
        <view class="search-chip {{type === 'income' ? 'search-chip--active' : ''}}" data-type="income" bindtap="onTypeChange">收入</view>
        <picker range="{{accounts}}" range-key="name" value="{{accountIndex}}" bindchange="onAccountChange">
          <view class="search-chip">{{accountIndex >= 0 ? accounts[accountIndex].name : '全部分类'}}</view>
        </picker>
      </view>
      <view class="search-actions">
        <glass-button variant="primary" block bind:tapbutton="onSearch">搜索</glass-button>
        <glass-button variant="secondary" block bind:tapbutton="onClear">清除</glass-button>
      </view>
    </glass-card>

    <view wx:if="{{searched && results.length === 0}}" class="search-empty">没有匹配的记录</view>

    <view wx:for="{{results}}" wx:key="id" class="search-result" data-id="{{item.id}}" bindtap="onOpenDetail">
      <view class="search-result__icon">{{item.icon}}</view>
      <view class="search-result__body">
        <view class="search-result__name">{{item.name}} · {{item.date}}</view>
        <view wx:if="{{item.note}}" class="search-result__note">{{item.note}}</view>
      </view>
      <view class="search-result__amount {{item.type === 'income' ? 'text-income' : 'text-expense'}}">
        {{item.type === 'income' ? '+' : '−'}} ¥{{item.amountText}}
      </view>
    </view>
  </view>
</view>
