<view class="theme-root {{compat && compat.rootClass ? compat.rootClass : ''}}" style="--nav-safe-top: {{navSafeTop}}px">
  <view class="bg-glow" />
  <view class="page-content {{enterSeq === 1 ? 'anim-tab-enter-a' : (enterSeq === 2 ? 'anim-tab-enter-b' : '')}}">
    <glass-card padded>
      <view class="mine-logo">简</view>
      <view class="mine-name">简记</view>
      <view class="mine-slogan">轻量、克制，打开即记</view>
    </glass-card>

    <view class="mine-section">
      <glass-cell title="分类管理" desc="自定义收支分类" icon="◇" data-url="/pages/category-manage/index" bind:tapcell="goTo" />
      <glass-cell title="预算设置" desc="月度总预算与分类预算" icon="◈" data-url="/pages/budget-manage/index" bind:tapcell="goTo" />
    </view>

    <view class="mine-section">
      <glass-cell title="数据管理" desc="导出备份 / 导入恢复" icon="⇅" data-url="/pages/data-manage/index" bind:tapcell="goTo" />
      <glass-cell title="云同步" desc="默认关闭，可插拔" icon="☁" data-url="/subpackages/cloud/pages/settings/index" bind:tapcell="goTo" />
    </view>

    <view class="mine-section">
      <glass-cell title="隐私指引" desc="数据用途与用户权利" icon="🛡" data-url="/pages/privacy/index" bind:tapcell="goTo" />
      <glass-cell title="用户协议" desc="服务条款与免责说明" icon="📄" data-url="/pages/terms/index" bind:tapcell="goTo" />
      <glass-cell title="关于简记" desc="版本与说明" icon="◉" data-url="/pages/about/index" bind:tapcell="goTo" />
    </view>
  </view>
</view>
