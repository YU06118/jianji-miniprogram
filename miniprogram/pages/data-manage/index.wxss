.dm-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--color-text-1);
}

.dm-stats {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.dm-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
}

.dm-stat__num {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--color-accent);
}

.dm-stat__label {
  font-size: var(--fs-caption);
  color: var(--color-text-3);
}

.dm-hint {
  font-size: var(--fs-caption);
  color: var(--color-text-3);
  margin-top: var(--sp-4);
}

.dm-actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-top: var(--sp-4);
}

.dm-action__title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-1);
}

.dm-action__desc {
  font-size: var(--fs-caption);
  color: var(--color-text-2);
  margin: var(--sp-2) 0 var(--sp-4);
  line-height: 1.6;
}
