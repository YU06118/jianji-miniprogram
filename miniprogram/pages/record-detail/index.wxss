.detail-empty {
  text-align: center;
  padding: var(--sp-7) 0;
  font-size: var(--fs-body);
  color: var(--color-text-2);
}

.detail-card__type {
  font-size: var(--fs-caption);
  color: var(--color-text-3);
}

.detail-card__amount {
  font-size: var(--fs-amount-lg);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  margin-top: var(--sp-2);
}

.detail-card__divider {
  margin: var(--sp-4) 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-4);
  padding: var(--sp-2) 0;
  font-size: var(--fs-body);
  color: var(--color-text-1);
}

.detail-row__label {
  color: var(--color-text-2);
  flex-shrink: 0;
}

.detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.detail-images__img {
  width: var(--sp-7);
  height: var(--sp-7);
  border-radius: var(--radius-input);
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-top: var(--sp-6);
}
