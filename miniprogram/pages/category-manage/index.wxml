<view class="theme-root {{pageEnterSeq === 1 ? 'anim-page-enter-a' : (pageEnterSeq === 2 ? 'anim-page-enter-b' : 'anim-page-enter-idle')}} {{compat && compat.rootClass ? compat.rootClass : ''}}" style="--nav-safe-top: {{navSafeTop}}px">
  <view class="bg-glow" />
  <nav-bar title="分类管理" />
  <view class="page-content page-content--under-nav">
    <view class="cat-tabs">
      <view class="cat-tab {{type === 'expense' ? 'cat-tab--active' : ''}}" data-type="expense" bindtap="onTypeChange">支出分类</view>
      <view class="cat-tab {{type === 'income' ? 'cat-tab--active' : ''}}" data-type="income" bindtap="onTypeChange">收入分类</view>
    </view>

    <glass-card padded wx:for="{{accounts}}" wx:key="_id" extClass="cat-item">
      <view class="cat-item__icon">{{item.icon}}</view>
      <view class="cat-item__body">
        <view class="cat-item__name">{{item.name}}</view>
        <view class="cat-item__badge">{{item.builtIn ? '预设' : '自定义'}}</view>
      </view>
      <view class="cat-item__actions">
        <view class="cat-item__btn" data-index="{{index}}" bindtap="onMoveUp">↑</view>
        <view class="cat-item__btn" data-id="{{item._id}}" bindtap="showEditDialog">✎</view>
        <view class="cat-item__btn cat-item__btn--danger" data-id="{{item._id}}" bindtap="onDelete">✕</view>
      </view>
    </glass-card>

    <view class="cat-add">
      <glass-button variant="primary" block bind:tapbutton="showAddDialog">＋ 新增分类</glass-button>
    </view>
  </view>

  <glass-sheet show="{{showAdd}}" title="{{editId ? '编辑分类' : '新增分类'}}" bind:close="closeDialog">
    <glass-card padded>
      <view class="cat-form__row">
        <text class="cat-form__label">名称</text>
        <input class="cat-form__input" value="{{formName}}" placeholder="分类名称" maxlength="12" bindinput="onNameInput" />
      </view>
      <view class="cat-form__row">
        <text class="cat-form__label">图标</text>
        <input class="cat-form__input" value="{{formIcon}}" placeholder="一个 emoji 或符号" maxlength="4" bindinput="onIconInput" />
      </view>
      <view class="cat-form__hint">自定义分类可编辑与删除；预设分类仅可改名。</view>
    </glass-card>
    <view class="cat-form__actions">
      <glass-button variant="primary" block bind:tapbutton="onSave">保存</glass-button>
      <glass-button variant="secondary" block bind:tapbutton="closeDialog">取消</glass-button>
    </view>
  </glass-sheet>
</view>
