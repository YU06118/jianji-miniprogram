/* 金额键盘：按压态 scale(0.98)，仅 transform/opacity */
.amount-pad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
  padding: var(--sp-3) var(--page-gutter) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: var(--color-glass-fallback);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-top: 1px solid var(--color-divider);
}

.amount-pad__key {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--sp-7);
  border-radius: var(--radius-button);
  background: var(--color-glass-fill);
  color: var(--color-text-1);
  font-size: var(--fs-title);
  font-variant-numeric: tabular-nums;
  transition:
    transform var(--dur-micro) var(--ease-standard),
    opacity var(--dur-micro) var(--ease-standard);
}

.amount-pad__key--pressed {
  transform: scale(var(--scale-press));
  opacity: 0.8;
}

.amount-pad__key--fn {
  color: var(--color-text-2);
}

.amount-pad__icon {
  font-size: var(--fs-title);
}

.glass--fallback .amount-pad {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
