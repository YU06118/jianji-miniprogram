/* GlassCard：四层玻璃材质，色值/圆角/间距/动效全部来自 token */
.glass-card {
  position: relative;
  border-radius: var(--radius-card);
  background: var(--color-glass-fill);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  isolation: isolate;
}

.glass-card--padded {
  padding: var(--card-padding);
}

/* 毛玻璃层 */
.glass-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  pointer-events: none;
}

/* 边缘层：渐变描边 + 顶部内高光（伪元素方案，不用 border-image） */
.glass-card::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(160deg, var(--color-glass-highlight), var(--color-divider));
  -webkit-mask:
    linear-gradient(var(--color-mask-solid) 0 0) content-box,
    linear-gradient(var(--color-mask-solid) 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  box-shadow: inset 0 1px 0 var(--color-glass-highlight);
  pointer-events: none;
}

/* 质感层：极淡噪点（占位，资源位提供时启用） */
.glass-card__noise {
  position: absolute;
  inset: 0;
  opacity: var(--noise-opacity);
  background-image: var(--texture-noise);
  pointer-events: none;
}

/* 降级：无 backdrop-filter 时用实色 + 强化描边 */
.glass--fallback .glass-card {
  background: var(--color-glass-fallback);
}

.glass--fallback .glass-card::before {
  display: none;
}

/* 按压态：scale + 透明度，抬起回弹，无颜色突变 */
.glass-card--interactive {
  transition:
    transform var(--dur-short) var(--ease-standard),
    opacity var(--dur-short) var(--ease-standard);
}

.glass-card--interactive:active {
  transform: scale(var(--scale-press));
  opacity: 0.9;
}
