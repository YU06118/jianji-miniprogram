.cloud-title { font-size: var(--fs-title-lg); font-weight: 700; color: var(--color-text-1); }
.cloud-desc { font-size: var(--fs-body); color: var(--color-text-2); line-height: 1.7; margin-top: var(--sp-2); }
.cloud-status { display: flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-body); color: var(--color-text-2); margin: var(--sp-4) 0; }
.cloud-status__dot { width: var(--sp-2); height: var(--sp-2); border-radius: var(--radius-pill); background: var(--color-text-weak); }
.cloud-status__dot--on { background: var(--color-income); }
.cloud-row { display: flex; justify-content: space-between; font-size: var(--fs-body); color: var(--color-text-2); margin-bottom: var(--sp-4); }
.cloud-error { font-size: var(--fs-caption); color: var(--color-warning); margin-bottom: var(--sp-3); }
.cloud-link { font-size: var(--fs-body); color: var(--color-accent); margin-top: var(--sp-4); }
