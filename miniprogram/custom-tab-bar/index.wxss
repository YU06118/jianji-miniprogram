/*
 * 自定义 tabBar（交互修复第一批强化）：不透明深色面板底 + 顶部发丝线 + 滑动指示条。
 * 关键：custom-tab-bar 是框架级独立挂载的组件——不在页面 .theme-root 节点树内，
 * 也不继承 app.wxss。必须显式 @import theme.wxss，并在根节点挂 theme-root 类，
 * 组件内的 var(--color-*) / var(--z-*) 等变量才会解析，否则全部回退初始值
 * （背景透明、文字黑、无毛玻璃）——这正是"tabbar 融进背景"的真因。
 * 按压反馈用 hover-class（真机 :active 触发不稳定）。
 */
@import "../theme.wxss";

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-tabbar);
  display: flex;
  height: calc(var(--size-tabbar-h) + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-tab-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--shadow-sheet);
}

/* 顶部发丝线：与页面背景明确分界 */
.tabbar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, var(--color-transparent), var(--color-tab-line), var(--color-transparent));
}

.tabbar__item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  color: var(--color-tab-inactive);
  transition:
    transform var(--dur-micro) var(--ease-standard),
    opacity var(--dur-micro) var(--ease-standard),
    color var(--dur-short) var(--ease-standard);
}

/* 按压态（第四轮重做）：肉眼可辨——整项 scale(0.94) + 图标 scale(0.88) + 图标高亮底 +
   文字提亮。旧版 translateY(-1px)+opacity 0.85 在深色玻璃底上等于没变，故弃用；
   按压不再用 opacity 表达（玻璃底不可见）。hover 与 touch 两路视觉保持一致。 */
.tabbar__item--hover,
.tabbar__item--pressed {
  transform: scale(0.94);
  color: var(--color-text-1);
}

.tabbar__item--hover .tabbar__icon,
.tabbar__item--pressed .tabbar__icon {
  transform: scale(0.88);
  background: var(--color-glass-fill);
  border-radius: var(--radius-pill);
  padding: 2px 10px;
}

.tabbar__item--hover .tabbar__text,
.tabbar__item--pressed .tabbar__text {
  color: var(--color-text-1);
}

.tabbar__icon {
  font-size: var(--size-icon);
  line-height: 1;
  transition:
    transform var(--dur-micro) var(--ease-standard),
    background-color var(--dur-micro) var(--ease-standard);
}

.tabbar__text {
  font-size: var(--fs-caption);
}

/* 选中态：accent 图标 + 高亮文字（指示条独立在 tabbar 层滑动） */
.tabbar__item--active {
  color: var(--color-accent);
}

.tabbar__item--active .tabbar__text {
  color: var(--color-text-1);
  font-weight: 600;
}

/* 选中指示条：容器占 1/3 宽，按 selected 平移（wxml 内联 transform），内部短条居中 */
.tabbar__indicator-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: calc(100% / 3);
  height: 3px;
  display: flex;
  justify-content: center;
  transition:
    transform var(--dur-short) var(--ease-standard),
    opacity var(--dur-micro) var(--ease-standard);
}

/* 按压联动：按下任意 tab 时指示条降透明度，松开恢复 */
.tabbar__indicator-wrap--dim {
  opacity: 0.9;
}

.tabbar__indicator {
  width: 20px;
  height: 3px;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
}

/* 毛玻璃降级（组件内 class 控制，原页面跨界选择器因隔离从未生效） */
.tabbar--fallback {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  background: var(--color-tab-bg-solid);
}
