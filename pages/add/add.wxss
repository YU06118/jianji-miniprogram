.add-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ========== 顶部 ========== */
.head {
  flex-shrink: 0;
  padding: var(--sp-4) var(--sp-gutter) var(--sp-4);
  background: var(--card);
  border-radius: 0 0 var(--r-card-lg) var(--r-card-lg);
  box-shadow: var(--sh-raised);
}

.type-seg {
  display: inline-flex;
  background: var(--bg-2);
  border-radius: var(--r-ctrl);
  padding: 6rpx;
}
.type-seg-i {
  padding: 14rpx 40rpx;
  border-radius: var(--r-ctrl);
  font-size: var(--fs-footnote);
  color: var(--ink-2);
  transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
}
.type-seg-i.on {
  color: var(--on-accent);
  background: var(--accent-solid);
  font-weight: 700;
  box-shadow: var(--sh-pop);
}

.amt-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  min-height: 108rpx;
}
.cur {
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.amt-input {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
  color: var(--ink);
  background: transparent;
  border: none;
  padding: 0;
}
.amt-ph {
  color: var(--ink-3);
  font-size: 88rpx;
  font-weight: 700;
}

.cat-badge {
  margin-left: auto;
  align-self: center;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--r-ctrl);
  background: var(--bg-2);
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.badge-ico { width: 32rpx; height: 32rpx; display: block; }

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}
.meta-pill {
  background: var(--bg-2);
  border-radius: var(--r-card);
  padding: 14rpx 22rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  flex-shrink: 0;
  margin-right: 14rpx;
}
.note-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-2);
  border-radius: var(--r-card);
  padding: 0 20rpx;
  min-width: 0;
}
.note-input {
  flex: 1;
  height: 66rpx;
  font-size: 26rpx;
  color: var(--ink);
  min-width: 0;
}
.ph {
  color: var(--ink-3);
  font-size: 25rpx;
}
.note-clear {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
  font-size: 26rpx;
  flex-shrink: 0;
}

/* ========== 中部 ========== */
.mid {
  flex: 1;
  height: 0;
  overflow: hidden;
}

.sec {
  padding: 26rpx 28rpx 0;
}
.sec-t {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--ink-2);
  font-weight: 600;
  margin-bottom: 16rpx;
}
.sec-hint {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.sec-hint.auto {
  color: var(--mint);
}

/* 常用标签 */
.quick-scroll {
  white-space: nowrap;
  width: 100%;
}
.quick-wrap {
  display: inline-flex;
  padding-bottom: 10rpx;
}
.quick {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 148rpx;
  padding: 20rpx 22rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--r-card);
  margin-right: 16rpx;
  box-shadow: var(--sh-card);
}
.quick-on {
  background: var(--pink-soft);
  transform: scale(0.97);
}
.q-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.q-note {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  max-width: 170rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.q-amt {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--pink);
  margin-top: 4rpx;
}

/* 分类网格 4 列 */
.cats {
  display: flex;
  flex-wrap: wrap;
}
.cat {
  width: calc((100% - 36rpx) / 4);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  height: 118rpx;
  border-radius: var(--r-card);
  background: var(--card);
  border: 2rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform .15s var(--ease), background-color .15s var(--ease);
}
.cat:nth-child(4n) {
  margin-right: 0;
}
.cat.on {
  background: var(--pink-soft);
  border-color: var(--pink);
}
.cat.on .c-name {
  color: var(--pink-deep);
  font-weight: 600;
}
.cat-on {
  transform: scale(0.95);
}
.c-ico {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 8rpx;
}
.c-name {
  font-size: 23rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

.tip {
  padding: 16rpx 28rpx 26rpx;
}
.tip-txt {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.65;
}

/* ========== 底部保存 ========== */
.save-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-2);
  border-top: 1rpx solid var(--line);
}
