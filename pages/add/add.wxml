<view class="add-page {{theme}} {{modeClass}} {{perf}} {{pageFade ? 'page-fade' : ''}}">
  <view class="aurora" aria-hidden="true">
    <view class="aurora-blob aurora-b1"></view>
    <view class="aurora-blob aurora-b2"></view>
  </view>

  <!-- ========== 顶部输入区 ========== -->
  <view class="head">
    <!-- 支出 / 收入 -->
    <view class="type-seg">
      <view class="type-seg-i {{type === 'expense' ? 'on' : ''}}"
            data-t="expense" bindtap="onType">支出</view>
      <view class="type-seg-i {{type === 'income' ? 'on' : ''}}"
            data-t="income" bindtap="onType">收入</view>
    </view>

    <!-- 金额 -->
    <view class="amt-row">
      <text class="cur">¥</text>
      <input class="amt-input num"
             type="digit"
             value="{{amountStr}}"
             bindinput="onAmountInput"
             bindconfirm="onConfirm"
             confirm-type="done"
             placeholder="0"
             placeholder-class="amt-ph"
             focus="{{amountFocus}}"
             maxlength="10" />
      <view class="cat-badge">
        <image class="badge-ico" src="/assets/icons/{{curCat.key}}.svg" mode="aspectFit"/>
        <text>{{curCat.name}}</text>
      </view>
    </view>

    <!-- 日期 + 备注 -->
    <view class="meta-row">
      <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate">
        <view class="meta-pill">
          <text>📅 {{dateLabel}}</text>
        </view>
      </picker>
      <view class="note-box">
        <input class="note-input"
               value="{{note}}"
               placeholder="加个备注，我会自动猜分类"
               placeholder-class="ph"
               maxlength="30"
               confirm-type="done"
               bindinput="onNote" />
        <view class="note-clear" wx:if="{{note}}" catchtap="clearNote">✕</view>
      </view>
    </view>
  </view>

  <!-- ========== 中部滚动区 ========== -->
  <scroll-view class="mid" scroll-y enable-flex>

    <!-- 今日概览：记前瞄一眼当日累计 -->
    <view class="stat-row">
      <view class="stat">
        <text class="stat-k">今日花掉</text>
        <text class="stat-v num">¥{{todayText}}</text>
      </view>
      <view class="stat">
        <text class="stat-k">本月支出</text>
        <text class="stat-v num">¥{{monthText}}</text>
      </view>
      <view class="stat">
        <text class="stat-k">今日已记</text>
        <text class="stat-v num">{{todayCountText}} 笔</text>
      </view>
    </view>

    <!-- 分类 -->
    <view class="sec">
      <view class="sec-t">
        <text>{{type === 'expense' ? '支出分类' : '收入分类'}}</text>
        <text class="sec-hint" wx:if="{{catTouched}}">已手动选</text>
        <text class="sec-hint auto" wx:elif="{{autoHint}}">已自动猜中</text>
      </view>
      <view class="cats">
        <view class="cat {{cat === item.key ? 'on' : ''}}"
              wx:for="{{cats}}" wx:key="key"
              hover-class="cat-on" hover-stay-time="60"
              data-k="{{item.key}}" bindtap="onCat">
          <image class="c-ico" src="/assets/icons/{{item.key}}.svg" mode="aspectFit"/>
          <text class="c-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="tip">
      <text class="tip-txt">备注里写「菜市场」「奶茶」，下次输入时会自动猜中分类。</text>
    </view>
  </scroll-view>

  <!-- ========== 底部保存 ========== -->
  <view class="save-bar">
    <view class="btn btn-primary btn-block" bindtap="onConfirm">
      {{editingId ? '保存修改' : '保存这一笔'}}
    </view>
  </view>

</view>
