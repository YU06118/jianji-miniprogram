/* pages/budget/budget.wxss */

.card-title {
  display: block;
}
.sub {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  line-height: 1.55;
}

/* ============ 总预算输入 ============ */
.total-input {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid var(--pink-soft);
}
.ti-cur {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--pink);
  margin-right: 12rpx;
}
.ti-in {
  flex: 1;
  /* 小程序 input 默认内容高约 52.5rpx 且裁字：必须显式给高（≥1.4×字号），否则字形被压成竖椭圆 */
  height: 100rpx;
  line-height: 100rpx;
  font-size: 68rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -1rpx;
  min-width: 0;
}
.ti-unit {
  font-size: 24rpx;
  color: var(--ink-3);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.ph {
  color: var(--ink-3);
  font-weight: 400;
}

.sug-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}
.sug-pill {
  font-size: var(--fs-caption);
  color: var(--pink);
  background: var(--pink-mist);
  border-radius: var(--r-chip);
  padding: 14rpx var(--sp-3);
  margin-right: 14rpx;
  margin-bottom: 12rpx;
}
.sug-pill:active {
  background: var(--pink-soft);
}

/* ============ 分项预算 ============ */
.cb-item {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line);
}
.cb-item:last-of-type {
  border-bottom: none;
}
.cb-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-card);
  background: var(--bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cb-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  flex-shrink: 0;
}
.cb-right {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.cb-cur {
  font-size: 25rpx;
  color: var(--ink-3);
  margin-right: 6rpx;
}
.cb-in {
  width: 200rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: right;
}

.cb-sum {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--r-card);
  background: var(--bg-2);
  font-size: 26rpx;
  color: var(--ink-2);
}
.cb-sum.warn {
  background: var(--amber-soft);
  color: var(--amber);
}
.cb-diff {
  font-size: 23rpx;
  font-weight: 600;
}

/* ============ 提示 ============ */
.tip-box {
  padding: 4rpx 40rpx var(--sp-5);
}
/* 底部固定保存条的显式预留：按钮 88 + 上下 padding 48 + 余量 64 = 200rpx + 安全区。
   预留职责集中在页级类，替代原 tip-box 220rpx 经验值。 */
.page-has-bar {
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.tip-line {
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.7;
  margin-bottom: 14rpx;
}

/* ============ 底部按钮 ============ */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  /* 液态玻璃：半透明底 + 背景模糊（仅此一处 fixed 浮层使用） */
  background: var(--glass);
  -webkit-backdrop-filter: blur(20px) saturate(1.5);
  backdrop-filter: blur(20px) saturate(1.5);
  border-top: 1rpx solid var(--glass-edge);
  padding: var(--sp-3) var(--sp-gutter);
  padding-bottom: calc(var(--sp-3) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--sp-3) + env(safe-area-inset-bottom));
  border-radius: var(--r-card-lg) var(--r-card-lg) 0 0;
  box-shadow: var(--sh-raised);
  display: flex;
  align-items: center;
}
.save-bar .btn {
  flex: 1;
}
.btn-clear {
  flex: 0 0 210rpx !important;
  margin-left: 20rpx;
}


/* 低端设备降级：关毛玻璃，保留实底与阴影 */
.low-end .save-bar {
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
  background: var(--card) !important;
}
