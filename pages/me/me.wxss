/* pages/me/me.wxss */

/* ============ 概览卡 ============ */
.head-card {
  position: relative;
  margin: var(--sp-4) var(--sp-gutter) var(--sp-2);
  padding: var(--sp-5) var(--sp-4);
  border-radius: var(--r-card-lg);
  overflow: hidden;
  color: var(--on-accent);
  background: var(--accent-solid);
  box-shadow: var(--sh-raised);
}
.hc-mask {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  top: -150rpx;
  right: -100rpx;
}
.hc-t {
  position: relative;
  z-index: 1;
  display: block;
  font-size: var(--fs-title);
  font-weight: 700;
  letter-spacing: -2rpx;
}
.hc-s {
  position: relative;
  z-index: 1;
  display: block;
  font-size: var(--fs-footnote);
  opacity: 0.94;
  margin-top: var(--sp-2);
}
.hc-grid {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: var(--sp-5);
  padding-top: var(--sp-3);
}
.hc-i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hc-v {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
}
.hc-k {
  font-size: 21rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}

/* ============ 设置入口行 ============ */
