/* pages/me/me.wxss */

/* ============ 概览卡 ============ */
.head-card {
  position: relative;
  margin: 24rpx 28rpx 8rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: var(--r-card);
  overflow: hidden;
  color: #FFFFFF;
  background: var(--accent-solid);
  box-shadow: var(--sh-pop);
}
.hc-mask {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.11);
  top: -150rpx;
  right: -100rpx;
}
.hc-t {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hc-s {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 24rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}
.hc-grid {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}
.hc-i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hc-v {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
}
.hc-k {
  font-size: 21rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}
.hc-line {
  width: 2rpx;
  height: 46rpx;
  background: rgba(255, 255, 255, 0.24);
}

/* ============ 设置入口行 ============ */
.group {
  background: var(--card);
  border-radius: var(--r-card);
  margin-top: 24rpx;
  overflow: hidden;
  box-shadow: var(--sh-card);
}
.cell {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 2rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.cell-on { background: var(--pink-soft); }
.c-ico { width: 56rpx; font-size: 34rpx; flex-shrink: 0; }
.c-t { font-size: 29rpx; color: var(--ink); font-weight: 500; }
.c-v { margin-left: auto; font-size: 26rpx; color: var(--ink-3); }
.c-go { font-size: 34rpx; color: var(--ink-3); margin-left: 14rpx; flex-shrink: 0; }
