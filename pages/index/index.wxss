/* pages/index/index.wxss */

/* ================= 顶部主卡 ================= */
.hero {
  position: relative;
  /* 首屏顶距由 .page 的 padding-top 承载（防 margin 塌陷露色缝）；
     translateZ 强制独立合成层，修 devtools/WebView 对 overflow+负偏移装饰圆的裁切伪影 */
  margin: 0 var(--sp-gutter) 0;
  padding: var(--sp-5) var(--sp-5) var(--sp-4);
  border-radius: var(--r-card-lg);
  overflow: hidden;
  transform: translateZ(0);
  color: var(--on-accent);
  background: var(--accent-solid);
  box-shadow: var(--sh-raised);
}
.hero.tone-warn {
  background: var(--amber-solid);
  box-shadow: var(--sh-pop);
}
.hero.tone-over {
  background: var(--danger-solid);
  box-shadow: var(--sh-pop);
}

.hero-mask1 {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  top: -140rpx;
  right: -90rpx;
}
.hero-mask2 {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  bottom: -130rpx;
  right: 70rpx;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-label {
  font-size: var(--fs-footnote);
  opacity: 0.96;
  letter-spacing: 1rpx;
}
.hero-pill {
  font-size: var(--fs-caption);
  padding: 12rpx var(--sp-3);
  min-height: 56rpx;
  border-radius: var(--r-chip);
  background: rgba(255, 255, 255, 0.24);
}
.hero-pill:active {
  background: rgba(255, 255, 255, 0.38);
}

.hero-num {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin: 18rpx 0 28rpx;
}
.hero-cur {
  font-size: 52rpx;
  font-weight: 700;
  margin-right: var(--sp-1);
}
.hero-amt {
  font-size: var(--fs-hero);
  font-weight: 700;
  letter-spacing: -4rpx;
  line-height: 1.05;
}

.hero-bar {
  position: relative;
  z-index: 1;
}
.hero .bar {
  background: rgba(255, 255, 255, 0.26);
}
.hero .bar-fill {
  background: var(--on-accent);
  border-radius: var(--r-full);
}

.hero-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: var(--fs-footnote);
  opacity: 0.96;
}
.hero-meta .dot {
  margin: 0 12rpx;
  opacity: 0.6;
}
.hero-meta.solo {
  margin-top: 26rpx;
  line-height: 1.55;
  opacity: 0.88;
}

.hero-foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
}
.foot-k {
  font-size: var(--fs-footnote);
  opacity: 0.94;
}
.foot-v {
  font-size: 32rpx;
  font-weight: 700;
}

.hero-cta {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-radius: var(--r-card);
  background: rgba(255, 255, 255, 0.96);
  color: var(--accent-solid);
  font-size: 27rpx;
  font-weight: 600;
}
.hero-cta .arrow {
  font-size: 32rpx;
}
.hero-cta:active {
  background: var(--on-accent);
  transform: translateY(-2rpx);
}

/* ================= 预警条 ================= */
.alert {
  display: flex;
  align-items: flex-start;
  margin-top: var(--sp-4);
  padding: var(--sp-4);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
}
.alert.tone-ok {
  background: var(--mint-soft);
}
.alert.tone-warn {
  background: var(--amber-soft);
}
.alert.tone-over {
  background: var(--danger-soft);
}
.alert-badge {
  font-size: 36rpx;
  line-height: 1.05;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.alert-body {
  flex: 1;
  min-width: 0;
}
.alert-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: var(--sp-1);
}
.alert-text {
  font-size: var(--fs-footnote);
  color: var(--ink-2);
  line-height: 1.55;
}
.alert-go {
  font-size: 38rpx;
  color: var(--ink-3);
  align-self: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ================= 快捷记账 ================= */
.quick-scroll {
  width: 100%;
  margin-top: var(--sp-4);
  white-space: nowrap;
}
.quick-wrap {
  display: inline-flex;
  padding-bottom: 8rpx;
}

.q-add {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  margin-right: var(--sp-4);
  border-radius: var(--r-card);
  border: 1rpx solid var(--pink);
  background: var(--pink-mist);
  flex-shrink: 0;
}
.q-add:active {
  background: var(--pink-soft);
  transform: scale(0.97);
}
.q-add-plus {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--pink);
  line-height: 1;
}
.q-add-txt {
  font-size: var(--fs-footnote);
  font-weight: 600;
  color: var(--pink);
  margin-top: var(--sp-1);
}

.q-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  height: 168rpx;
  padding: 0 var(--sp-3);
  margin-right: var(--sp-4);
  border-radius: var(--r-card);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: var(--sh-card);
  flex-shrink: 0;
}
.q-on {
  background: var(--pink-soft);
  transform: scale(0.97);
}
.q-ico {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.q-note {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: var(--sp-1);
  max-width: 176rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.q-amt {
  font-size: var(--fs-footnote);
  font-weight: 700;
  color: var(--pink);
  margin-top: var(--sp-1);
}

.quick-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 14rpx;
}

/* ================= 本月概览 ================= */
.stat-row {
  display: flex;
  align-items: center;
  /* 上下都留白：与上方快捷区、下方「最近 7 天」卡片分离，避免两窗相连 */
  margin: var(--sp-4) 0;
  padding: var(--sp-4) 0;
  background: var(--card);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat:active {
  opacity: 0.7;
}
.stat-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-2);
}
.stat-v {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.stat-v.income {
  color: var(--mint);
}
/* ================= 近 7 天 ================= */
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  margin: var(--sp-4) 0 var(--sp-2);
}
.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-col-fill {
  width: 44rpx;
  min-height: 8rpx;
  border-radius: var(--r-ctrl) var(--r-ctrl) 0 0;
  transition: height var(--dur) var(--ease);
}
.bar-x {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-2);
}
.bars-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 10rpx;
}

/* ================= 最近记录 ================= */
.rec {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line);
}
.rec:last-child {
  border-bottom: none;
}
.rec:active {
  opacity: 0.66;
}
.rec-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-card);
  background: var(--bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rec-mid {
  flex: 1;
  min-width: 0;
}
.rec-note {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-1);
}
.rec-amt {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-left: var(--sp-3);
  flex-shrink: 0;
}
.rec-amt.income {
  color: var(--mint);
}
.rec-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding-top: 22rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 34rpx 40rpx 30rpx;
  line-height: 1.6;
}


/* 内容加载：列表项逐个渐显（合成器 opacity，仅在首次挂载时播放一次） */
.q-item:nth-child(2) { animation: fade-in var(--dur) var(--ease) both; }
.q-item:nth-child(3) { animation: fade-in var(--dur) var(--ease) .04s both; }
.q-item:nth-child(4) { animation: fade-in var(--dur) var(--ease) .08s both; }
.q-item:nth-child(5) { animation: fade-in var(--dur) var(--ease) .12s both; }
.rec:nth-child(1) { animation: fade-in var(--dur) var(--ease) both; }
.rec:nth-child(2) { animation: fade-in var(--dur) var(--ease) .04s both; }
.rec:nth-child(3) { animation: fade-in var(--dur) var(--ease) .08s both; }
.rec:nth-child(4) { animation: fade-in var(--dur) var(--ease) .12s both; }
.rec:nth-child(5) { animation: fade-in var(--dur) var(--ease) .16s both; }
.rec:nth-child(6) { animation: fade-in var(--dur) var(--ease) .2s both; }


/* ================= 自定义金额档位 ================= */
/* 页面级 sheet：保留全局 transform+show 开关，仅补 flex 布局与内部件 */
.sheet {
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx 0;
}
.cq-head {
  padding: 8rpx 0 22rpx;
  border-bottom: 1rpx solid var(--line);
}
.cq-tip { font-size: 24rpx; color: var(--ink-3); line-height: 1.5; padding: 16rpx 0 8rpx; }
.cq-cats { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 12rpx 0 20rpx; }
.cq-cat {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--r-chip);
  background: var(--bg-2);
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: var(--ink-2);
  transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
}
.cq-cat.on { background: var(--pink-mist); border-color: var(--pink); color: var(--pink-deep); font-weight: 700; }
.cq-cat-emoji { font-size: 28rpx; }
.cq-amt-in { font-size: 40rpx; font-weight: 700; }
.cq-existing { margin-top: 24rpx; padding-bottom: 24rpx; }
.cq-existing-title { font-size: 24rpx; color: var(--ink-3); margin-bottom: 8rpx; }
.cq-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--line);
}
.cq-row:last-child { border-bottom: none; }
.cq-row-emoji { font-size: 34rpx; width: 64rpx; flex-shrink: 0; }
.cq-row-note { font-size: 30rpx; color: var(--ink); flex: 1; min-width: 0; }
.cq-row-amt { font-size: 32rpx; font-weight: 700; color: var(--ink); margin-left: 16rpx; }
.cq-row-del { font-size: 30rpx; color: var(--danger); width: 72rpx; text-align: center; flex-shrink: 0; }
.sheet-body { overflow-y: auto; flex: 1; }
.sheet-safe { height: constant(safe-area-inset-bottom); height: env(safe-area-inset-bottom); flex-shrink: 0; }


/* ================= 长按气泡菜单（按压位置下方） ================= */
.pop-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 96;
  background: transparent;   /* 仅承接点击与挡滚动，不暗化底层 */
}
.pop-menu {
  position: fixed;
  z-index: 97;
  /* 文字横向平铺：菜单需容纳最长文案「自定义金额/删这个档位」(5×32rpx=160rpx)
     + 左右 padding(64rpx) + 图标(56rpx) = 280rpx，取 300rpx 留余量。
     文字区 flex:1 保留自动换行能力，正常单行显示，长文案才折行，不再一字一行。 */
  width: 300rpx;
  padding: 8rpx 0;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-card);
  box-shadow: var(--sh-raised);
  overflow: hidden;
  transform-origin: top center;
}
.pop-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--sp-4);
  font-size: var(--fs-body);
  color: var(--ink);
}
.pop-item:active { background: var(--pink-soft); }
.pop-item + .pop-item { border-top: 1rpx solid var(--line); }
.pop-ico {
  width: 56rpx;
  font-size: 32rpx;
  color: var(--pink);
  flex-shrink: 0;
}
.pop-txt { flex: 1; min-width: 0; }
.pop-danger .pop-ico, .pop-danger .pop-txt { color: var(--danger); }
.pop-danger:active { background: var(--danger-soft); }
