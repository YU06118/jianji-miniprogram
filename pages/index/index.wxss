/* pages/index/index.wxss */

/* ================= 顶部主卡 ================= */
.hero {
  position: relative;
  margin: 24rpx 28rpx 0;
  padding: 36rpx 36rpx 34rpx;
  border-radius: var(--r-card);
  overflow: hidden;
  color: #FFFFFF;
  background: var(--accent-solid);
  box-shadow: var(--sh-pop);
}
.hero.tone-warn {
  background: var(--amber-solid);
  box-shadow: var(--sh-pop);
}
.hero.tone-over {
  background: var(--danger-solid);
  box-shadow: var(--sh-pop);
}

.hero-mask1 {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  top: -140rpx;
  right: -90rpx;
}
.hero-mask2 {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  bottom: -130rpx;
  right: 70rpx;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-label {
  font-size: 27rpx;
  opacity: 0.94;
  letter-spacing: 1rpx;
}
.hero-pill {
  font-size: 23rpx;
  padding: 7rpx 20rpx;
  border-radius: var(--r-chip);
  background: rgba(255, 255, 255, 0.24);
}
.hero-pill:active {
  background: rgba(255, 255, 255, 0.38);
}

.hero-num {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin: 18rpx 0 28rpx;
}
.hero-cur {
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 8rpx;
}
.hero-amt {
  font-size: 86rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
}

.hero-bar {
  position: relative;
  z-index: 1;
}
.hero .bar {
  background: rgba(255, 255, 255, 0.26);
}
.hero .bar-fill {
  background: #FFFFFF;
  border-radius: var(--r-ctrl);
}

.hero-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  opacity: 0.94;
}
.hero-meta .dot {
  margin: 0 12rpx;
  opacity: 0.6;
}
.hero-meta.solo {
  margin-top: 26rpx;
  line-height: 1.55;
  opacity: 0.88;
}

.hero-foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}
.foot-k {
  font-size: 25rpx;
  opacity: 0.92;
}
.foot-v {
  font-size: 32rpx;
  font-weight: 700;
}

.hero-cta {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-radius: var(--r-ctrl);
  background: rgba(255, 255, 255, 0.96);
  color: var(--accent-solid);
  font-size: 27rpx;
  font-weight: 600;
}
.hero-cta .arrow {
  font-size: 32rpx;
}
.hero-cta:active {
  background: #FFFFFF;
  transform: scale(0.99);
}

/* ================= 预警条 ================= */
.alert {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 26rpx 26rpx 26rpx 24rpx;
  border-radius: var(--r-card);
}
.alert.tone-ok {
  background: var(--mint-soft);
}
.alert.tone-warn {
  background: var(--amber-soft);
}
.alert.tone-over {
  background: var(--danger-soft);
}
.alert-badge {
  font-size: 36rpx;
  line-height: 1.05;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.alert-body {
  flex: 1;
  min-width: 0;
}
.alert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}
.alert-text {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.alert-go {
  font-size: 38rpx;
  color: var(--ink-3);
  align-self: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ================= 快捷记账 ================= */
.quick-scroll {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}
.quick-wrap {
  display: inline-flex;
  padding-bottom: 8rpx;
}

.q-add {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  margin-right: 16rpx;
  border-radius: var(--r-card);
  border: 3rpx dashed var(--pink);
  background: var(--pink-mist);
  flex-shrink: 0;
}
.q-add:active {
  background: var(--pink-soft);
  transform: scale(0.97);
}
.q-add-plus {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--pink);
  line-height: 1;
}
.q-add-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--pink);
  margin-top: 8rpx;
}

.q-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 152rpx;
  height: 152rpx;
  padding: 0 22rpx;
  margin-right: 16rpx;
  border-radius: var(--r-card);
  background: var(--card);
  border: 2rpx solid var(--line);
  box-shadow: var(--sh-card);
  flex-shrink: 0;
}
.q-on {
  background: var(--pink-soft);
  transform: scale(0.97);
}
.q-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.q-note {
  font-size: 23rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  max-width: 176rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.q-amt {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--pink);
  margin-top: 4rpx;
}

.quick-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 14rpx;
}

/* ================= 本月概览 ================= */
.stat-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 30rpx 0;
  background: var(--card);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat:active {
  opacity: 0.7;
}
.stat-k {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}
.stat-v {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.stat-v.income {
  color: var(--mint);
}
.stat-line {
  width: 2rpx;
  height: 56rpx;
  background: var(--line);
}

/* ================= 近 7 天 ================= */
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 210rpx;
  margin: 28rpx 0 14rpx;
}
.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-col-fill {
  width: 36rpx;
  min-height: 8rpx;
  border-radius: var(--r-ctrl);
  transition: height 0.4s ease;
}
.bar-x {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 12rpx;
}
.bars-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 10rpx;
}

/* ================= 最近记录 ================= */
.rec {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rec:last-child {
  border-bottom: none;
}
.rec:active {
  opacity: 0.66;
}
.rec-ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-ctrl);
  background: var(--bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rec-mid {
  flex: 1;
  min-width: 0;
}
.rec-note {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 5rpx;
}
.rec-amt {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--ink);
  margin-left: 16rpx;
  flex-shrink: 0;
}
.rec-amt.income {
  color: var(--mint);
}
.rec-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding-top: 22rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 34rpx 40rpx 30rpx;
  line-height: 1.6;
}
