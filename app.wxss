/* app.wxss —— 全局设计系统 v4 · Fluent 2 暗色默认 + 手动外观模式
 * ---------------------------------------------------------------------------
 * 主题机制：page 定义浅色基准 + @media 深色兜底；根节点 .mode-dark/.mode-light
 *   由 JS 按用户外观选择挂载，显式 class 优先于 page 上继承的 media 值。
 * 双强调色：--pink = 前景（文字/图标，深色提亮）；--accent-solid = 背景（按钮/hero，深底配白字）。
 * 对比度：所有 solid 背景配白字 ≥4.5:1，--ink-3 各底色 ≥4.5:1（WCAG AA）。
 * 换色不换名：保留 --pink / --mint 等旧变量名。
 * --------------------------------------------------------------------------- */

page {
  /* ---------- 表面色（浅色基准） ---------- */
  --bg: #F5F5F7;
  --bg-2: #EDEDF2;
  --card: #FFFFFF;
  --line: #E5E5EA;
  --line-2: #D1D1D6;

  /* ---------- 强调色（前景用法） ---------- */
  --pink: #0078D4;
  --pink-deep: #005A9E;
  --pink-soft: #E8F1FB;
  --pink-mist: #F4F8FD;
  --accent-solid: #0078D4;   /* 背景用法：配白字 4.5+ */

  /* ---------- 辅助强调 ---------- */
  --lilac: #6B4EFF;
  --lilac-deep: #5B3FD6;
  --lilac-soft: #EFEBFF;

  /* ---------- 语义色 ---------- */
  --mint: #0E7C3A;
  --mint-soft: #E6F4EB;
  --mint-solid: #0E7C3A;
  --amber: #9D5D00;
  --amber-soft: #FFF4E5;
  --amber-solid: #9D5D00;
  --danger: #C42B1C;
  --danger-soft: #FDE7E5;
  --danger-solid: #C42B1C;

  /* ---------- 文字 ---------- */
  --ink: #242424;
  --ink-2: #616161;
  --ink-3: #686868;          /* 5.57:1 on white / 4.67:1 on bg-2（原 #9D9D9D 仅 2.7:1 不达标） */

  /* ---------- 圆角 / 阴影 / 缓动 / 间距 / 字号（Apple 卡片体系 v5） ----------
   * 圆角公式：短边 × 18%，卡片越大圆角越大；间距：横向固定 16pt(32rpx)，
   * 纵向 16/24pt(32/48rpx)；标题极重收紧字距，正文 ≥16px。
   * 硬约束：--ink 系列文字色与暗紫渐变逐字不动。 */
  --r-card: 32rpx;
  --r-card-lg: 44rpx;
  --r-sheet: 48rpx;
  --r-ctrl: 20rpx;
  --r-chip: 999rpx;
  --r-full: 999rpx;
  --sh-card: 0 1rpx 2rpx rgba(0, 0, 0, .03);
  --sh-raised: 0 10rpx 34rpx rgba(0, 0, 0, .09);
  --sh-pop: 0 6rpx 18rpx rgba(0, 120, 212, .22);
  --ease: cubic-bezier(.16, 1, .3, 1);
  --ease-standard: cubic-bezier(.25, .1, .25, 1);
  --dur: 280ms;
  --bounce: cubic-bezier(.16, 1, .3, 1);
  --on-accent: #FFFFFF;
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  --sp-6: 64rpx;
  --sp-gutter: 40rpx;
  --sp-section: 56rpx;
  --fs-caption: 24rpx;
  --fs-footnote: 26rpx;
  --fs-body: 32rpx;
  --fs-body-lg: 36rpx;
  --fs-headline: 44rpx;
  --fs-title: 56rpx;
  --fs-hero: 96rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: "Segoe UI Variable", "Segoe UI", "Microsoft YaHei UI", -apple-system, BlinkMacSystemFont, "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 32rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 首屏兜底：JS class 未挂上时跟随系统（page 层，优先级低于根节点 class） ---------- */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #202020;
    --bg-2: #2A2A2E;
    --card: #1D1D1F;
    --line: #3A3A3C;
    --line-2: #545458;
    --pink: #4CC2FF;
    --pink-deep: #7CD4FF;
    --pink-soft: #12364B;
    --pink-mist: #1A2933;
    --accent-solid: #0067BC;
    --lilac: #B39AFF;
    --lilac-deep: #B39AFF;
    --lilac-soft: #2E2745;
    --mint: #6CCB8F;
    --mint-soft: #1B3A29;
    --mint-solid: #0A6B31;
    --amber: #E8B55A;
    --amber-soft: #3E311A;
    --amber-solid: #8A5400;
    --danger: #FF7B66;
    --danger-soft: #47231E;
    --danger-solid: #A82316;
    --ink: #F5F5F5;
    --ink-2: #C8C8C8;
    --ink-3: #9E9E9E;
    --sh-card: 0 1rpx 2rpx rgba(0, 0, 0, .22);
    --sh-raised: 0 14rpx 40rpx rgba(0, 0, 0, .5);
    --sh-pop: 0 6rpx 18rpx rgba(0, 0, 0, .38);
  }
}

view, text, input, textarea, scroll-view, button {
  box-sizing: border-box;
}

/* =========================================================================
   外观模式：根节点显式 class，重声明全部 token（含阴影）
   系统深 + 用户浅 时靠子元素声明盖过 page 的继承值
   ========================================================================= */
.mode-dark {
  --bg: #202020;
  --bg-2: #2A2A2E;
  --card: #1D1D1F;
  --line: #3A3A3C;
  --line-2: #545458;
  --pink: #4CC2FF;
  --pink-deep: #7CD4FF;
  --pink-soft: #12364B;
  --pink-mist: #1A2933;
  --accent-solid: #0067BC;
  --lilac: #B39AFF;
  --lilac-deep: #B39AFF;
  --lilac-soft: #2E2745;
  --mint: #6CCB8F;
  --mint-soft: #1B3A29;
  --mint-solid: #0A6B31;
  --amber: #E8B55A;
  --amber-soft: #3E311A;
  --amber-solid: #8A5400;
  --danger: #FF7B66;
  --danger-soft: #47231E;
  --danger-solid: #A82316;
  --ink: #F5F5F5;
  --ink-2: #C8C8C8;
  --ink-3: #9E9E9E;
  --sh-card: 0 1rpx 2rpx rgba(0, 0, 0, .22);
  --sh-raised: 0 14rpx 40rpx rgba(0, 0, 0, .5);
  --sh-pop: 0 6rpx 18rpx rgba(0, 0, 0, .38);
}
.mode-light {
  --bg: #F5F5F7;
  --bg-2: #EDEDF2;
  --card: #FFFFFF;
  --line: #E5E5EA;
  --line-2: #D1D1D6;
  --pink: #0078D4;
  --pink-deep: #005A9E;
  --pink-soft: #E8F1FB;
  --pink-mist: #F4F8FD;
  --accent-solid: #0078D4;
  --lilac: #6B4EFF;
  --lilac-deep: #5B3FD6;
  --lilac-soft: #EFEBFF;
  --mint: #0E7C3A;
  --mint-soft: #E6F4EB;
  --mint-solid: #0E7C3A;
  --amber: #9D5D00;
  --amber-soft: #FFF4E5;
  --amber-solid: #9D5D00;
  --danger: #C42B1C;
  --danger-soft: #FDE7E5;
  --danger-solid: #C42B1C;
  --ink: #242424;
  --ink-2: #616161;
  --ink-3: #686868;
  --sh-card: 0 1rpx 2rpx rgba(0, 0, 0, .03);
  --sh-raised: 0 10rpx 34rpx rgba(0, 0, 0, .09);
  --sh-pop: 0 6rpx 18rpx rgba(0, 120, 212, .22);
}

/* =========================================================================
   主题色：四套强调色（前景 + solid 背景）
   注意：不再用 media 定义深色 accent——改为 .mode-dark.t-xxx 复合选择器，
   避免「系统深 + 用户浅」时 accent 被系统主题污染。
   ========================================================================= */
.t-pink {
  --pink: #0078D4; --pink-deep: #005A9E; --pink-soft: #E8F1FB; --pink-mist: #F4F8FD;
  --accent-solid: #0078D4; --sh-pop: 0 6rpx 18rpx rgba(0, 120, 212, .22);
}
.t-lilac {
  --pink: #6B4EFF; --pink-deep: #4E38C4; --pink-soft: #EFEBFF; --pink-mist: #F6F4FF;
  --accent-solid: #6B4EFF; --sh-pop: 0 6rpx 18rpx rgba(107, 78, 255, .22);
}
.t-blue {
  --pink: #00809D; --pink-deep: #006275; --pink-soft: #E5F4F7; --pink-mist: #F2FAFC;
  --accent-solid: #00758E; --sh-pop: 0 6rpx 18rpx rgba(0, 117, 142, .22);
}
.t-matcha {
  --pink: #0E7C3A; --pink-deep: #0A5E2C; --pink-soft: #E6F4EB; --pink-mist: #F2FAF5;
  --accent-solid: #0E7C3A; --sh-pop: 0 6rpx 18rpx rgba(14, 124, 58, .22);
}
/* 深色档：solid 色配白字均 ≥5.7:1 */
.mode-dark.t-pink {
  --pink: #4CC2FF; --pink-deep: #7CD4FF; --pink-soft: #12364B; --pink-mist: #1A2933;
  --accent-solid: #0067BC;
}
.mode-dark.t-lilac {
  --pink: #B39AFF; --pink-deep: #CBB8FF; --pink-soft: #2E2745; --pink-mist: #221D35;
  --accent-solid: #6246E0;
}
.mode-dark.t-blue {
  --pink: #4CC9E5; --pink-deep: #7FDBEF; --pink-soft: #123C46; --pink-mist: #1A2E34;
  --accent-solid: #006B85;
}
.mode-dark.t-matcha {
  --pink: #6CCB8F; --pink-deep: #94DBAB; --pink-soft: #1B3A29; --pink-mist: #1A2E22;
  --accent-solid: #0A6B31;
}

/* ---------- 布局 ---------- */
.page, .add-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: var(--bg);
  color: var(--ink);
}
/* 深底紫→黑渐变：仅 mode-dark（显式深色 / 跟随系统深色）生效；
   浅色档 mode-light 不命中，回退上面的 var(--bg) 浅底。
   复合选择器（0,2,0）压过 add.wxss 后加载的 .add-page。 */
.mode-dark.page,
.mode-dark.add-page {
  background: linear-gradient(180deg, #2E2745 0%, #202020 100%);
}
.wrap { padding: 0 28rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row-center { display: flex; align-items: center; justify-content: center; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.gap-8 { gap: 16rpx; }

/* ---------- 卡片（Apple：大圆角 + 明度差 + 极淡阴影，靠留白分层） ---------- */
.card {
  background: var(--card);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  margin-bottom: var(--sp-4);
  box-shadow: var(--sh-card);
}
.card-lg {
  background: var(--card);
  border-radius: var(--r-card-lg);
  padding: var(--sp-5);
  margin-bottom: var(--sp-4);
  box-shadow: var(--sh-raised);
}
.card-flat {
  background: var(--card);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  margin-bottom: var(--sp-4);
  border: 1rpx solid var(--line);
}
.card-tap { transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
.card-tap.tap-on { transform: translateY(-4rpx); box-shadow: var(--sh-raised); }
.card-title { font-size: var(--fs-headline); font-weight: 700; letter-spacing: -1rpx; color: var(--ink); margin-bottom: var(--sp-2); }
.card-sub { font-size: var(--fs-footnote); color: var(--ink-3); }

/* ---------- 文字 ---------- */
.t-hero { font-size: var(--fs-hero); font-weight: 700; letter-spacing: -4rpx; line-height: 1.05; }
.t-xl { font-size: var(--fs-title); font-weight: 700; letter-spacing: -2rpx; }
.t-lg { font-size: var(--fs-headline); font-weight: 700; letter-spacing: -1rpx; }
.t-md { font-size: var(--fs-body-lg); font-weight: 600; }
.t-sm { font-size: var(--fs-footnote); }
.t-xs { font-size: var(--fs-caption); }
.bold { font-weight: 700; }
.muted { color: var(--ink-3); }
.muted-2 { color: var(--ink-2); }
.num {
  font-family: "Segoe UI Variable", "Segoe UI", -apple-system, sans-serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---------- 按钮（Fluent：圆角矩形、纯色 accent、克制反馈） ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-ctrl);
  font-size: var(--fs-body);
  font-weight: 600;
  transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.btn.tap-on { transform: translateY(-2rpx); opacity: .9; }
.btn-primary {
  background: var(--accent-solid);
  color: var(--on-accent);
  box-shadow: var(--sh-pop);
}
.btn-primary.tap-on { background: var(--pink-deep); box-shadow: none; }
.btn-ghost { background: var(--pink-soft); color: var(--pink-deep); }
.btn-plain { background: var(--bg-2); color: var(--ink-2); }
.btn-sm { height: 72rpx; border-radius: var(--r-ctrl); font-size: var(--fs-footnote); padding: 0 var(--sp-4); }
.btn-danger { background: var(--danger-soft); color: var(--danger); }
.btn-block { width: 100%; }

/* ---------- 分段控件（Fluent Pivot 观感） ---------- */
.seg {
  display: flex;
  padding: 6rpx;
  background: var(--bg-2);
  border-radius: var(--r-ctrl);
}
.seg-item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-footnote);
  color: var(--ink-2);
  border-radius: var(--r-ctrl);
  transition: all var(--dur) var(--ease);
}
.seg-item.on {
  background: var(--card);
  color: var(--pink-deep);
  font-weight: 600;
  box-shadow: var(--sh-card);
}

/* ---------- 胶囊标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx var(--sp-3);
  border-radius: var(--r-chip);
  font-size: var(--fs-caption);
  font-weight: 600;
}
.pill-ok { background: var(--mint-soft); color: var(--mint); }
.pill-warn { background: var(--amber-soft); color: var(--amber); }
.pill-over { background: var(--danger-soft); color: var(--danger); }
.pill-plain { background: var(--bg-2); color: var(--ink-2); }
.pill-brand { background: var(--pink-soft); color: var(--pink-deep); }
.pill-lilac { background: var(--lilac-soft); color: var(--lilac-deep); font-size: 24rpx; }

/* ---------- 进度条 ---------- */
.bar { height: 12rpx; border-radius: var(--r-full); background: var(--bg-2); overflow: hidden; }
.bar-dark { background: var(--bg-2); }
.bar-fill {
  height: 100%;
  border-radius: var(--r-full);
  background: var(--on-accent);
  transition: width var(--dur) var(--ease);
}
.bar-fill.ok { background: var(--mint); }
.bar-fill.warn { background: var(--amber); }
.bar-fill.over { background: var(--danger); }
.bar-fill.brand { background: #fff; }

/* ---------- 分割线 ---------- */
.hr { height: 2rpx; background: var(--line); margin: 24rpx 0; }

/* ---------- 空状态 ---------- */
.empty { padding: 100rpx 40rpx; text-align: center; color: var(--ink-3); }
.empty-emoji { width: 112rpx; height: 112rpx; margin: 0 auto 24rpx; display: block; opacity: .7; }
.empty-txt { font-size: 27rpx; line-height: 1.7; }

/* ---------- 表单（Fluent：标签在上/左，下描边） ---------- */
.field { display: flex; align-items: center; min-height: 100rpx; border-bottom: 2rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.field-label { width: 190rpx; font-size: 28rpx; color: var(--ink-2); flex-shrink: 0; }
.field-input { flex: 1; font-size: 30rpx; color: var(--ink); text-align: right; }
.field-input.left { text-align: left; }
.field-unit { font-size: 26rpx; color: var(--ink-3); margin-left: 10rpx; }

/* ---------- 列表行 ---------- */
.list { background: var(--card); border-radius: var(--r-card); overflow: hidden; box-shadow: var(--sh-card); }
.list-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 var(--sp-4);
  border-bottom: 1rpx solid var(--line);
  transition: background var(--dur) var(--ease);
}
.list-row:last-child { border-bottom: none; }
.list-row.tap-on { background: var(--bg-2); }
.list-row-label { flex: 1; font-size: 29rpx; }
.list-row-value { font-size: 27rpx; color: var(--ink-3); }
.chev { color: var(--ink-3); font-size: 30rpx; margin-left: 10rpx; }

/* ---------- 分组列表（Apple：去硬分割线，靠留白与字重分层；me/settings 共用） ---------- */
.group-title {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding: var(--sp-4) var(--sp-2) var(--sp-1);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.group {
  background: var(--card);
  border-radius: var(--r-card);
  margin-top: var(--sp-4);
  overflow: hidden;
  box-shadow: var(--sh-card);
}
.cell {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: var(--sp-3) var(--sp-4);
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child, .cell.no-tap { border-bottom: none; }
.cell.no-tap { padding-bottom: var(--sp-2); }
.cell-on { background: var(--pink-soft); }
.cell.tap-on { background: var(--bg-2); }
.c-ico { width: 64rpx; font-size: 36rpx; flex-shrink: 0; }
.c-t { font-size: var(--fs-body); color: var(--ink); font-weight: 600; }
.c-sub { font-size: var(--fs-caption); color: var(--ink-3); margin-top: 4rpx; }
.c-v { margin-left: auto; font-size: var(--fs-footnote); color: var(--ink-3); }
.c-go { font-size: 34rpx; color: var(--ink-3); margin-left: var(--sp-2); flex-shrink: 0; }
.cell.danger .c-t { color: var(--danger); }

/* ---------- 图标容器（Apple：圆角方块 + 淡底，图标为 SVG） ---------- */
.ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-card);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ico-img { width: 44rpx; height: 44rpx; display: block; }

/* ---------- 底部弹层（半屏抽屉） ---------- */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .4);
  z-index: 90;
  opacity: 0;
  transition: opacity .2s var(--ease);
}
.sheet-mask.show { opacity: 1; }
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: var(--r-sheet) var(--r-sheet) 0 0;
  padding: 32rpx 32rpx 0;
  transform: translateY(100%);
  transition: transform var(--dur) var(--ease);
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.sheet.show { transform: translateY(0); }
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line-2);
  margin: 0 auto 24rpx;
}

/* ---------- 头像 / 贴纸 ---------- */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  background: var(--pink-soft);
}

/* ---------- 安全区 ---------- */
.safe-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 动画（Fluent：淡入 + 轻微上移，克制） ---------- */
@keyframes rise {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise { animation: rise var(--dur) var(--ease) both; }
.rise-2 { animation: rise var(--dur) var(--ease) .04s both; }
.rise-3 { animation: rise var(--dur) var(--ease) .08s both; }

/* 尊重系统「减弱动态效果」设置 */
@media (prefers-reduced-motion: reduce) {
  .rise, .rise-2, .rise-3, .bar-fill, .btn, .card-tap, .sheet, .sheet-mask { animation: none !important; transition: none !important; }
}
